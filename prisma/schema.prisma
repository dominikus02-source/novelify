// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  password        String?
  image           String?
  emailVerified   DateTime?
  plan            String    @default("free")
  subscriptionStatus String @default("free") // free | trialing | active | past_due | canceled | expired
  wordCountUsed   Int       @default(0)
  dailyWordCount  Int       @default(0)
  dailyWordDate   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  projects        Project[]
  exportJobs      ExportJob[]
  accounts        Account[]
  sessions        Session[]
  settings        UserSettings?
  subscription    Subscription?
  usageTracking   UsageTracking[]
}

model UserSettings {
  id                               String   @id @default(cuid())
  userId                           String   @unique
  user                             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Profile
  penName                          String?
  authorBio                        String?
  defaultAuthorName                String?
  website                          String?

  // Language & AI Output
  defaultSourceLanguage            String   @default("id")
  defaultTargetLanguage            String   @default("en")
  defaultAiOutputLanguage          String   @default("en")
  alwaysUseProjectTargetLanguage   Boolean  @default(true)
  translationStyle                 String   @default("literary")
  preserveCharacterNames           Boolean  @default(true)
  preservePlaceNames               Boolean  @default(true)
  glossaryBehavior                 String   @default("preserve")

  // Writing Preferences
  defaultGenre                     String?
  defaultPOV                       String   @default("third_person_limited")
  defaultTense                     String   @default("past")
  defaultChapterWordTarget         Int      @default(3000)
  defaultDailyWordGoal             Int      @default(1000)
  autosaveInterval                 Int      @default(2000)
  defaultWritingMode               String   @default("chapter")
  manuscriptFont                   String   @default("serif")
  editorDensity                    String   @default("comfortable")

  // AI Preferences
  aiCreativity                     String   @default("balanced")
  defaultTone                      String   @default("literary")
  proseStyle                       String   @default("clean")
  contentLevel                     String   @default("general")
  aiSuggestionMode                 String   @default("append_after_confirmation")
  includeStoryBibleContext         Boolean  @default(true)
  includePreviousChapterContext    Boolean  @default(true)
  includeStyleGuideContext         Boolean  @default(true)

  // Export & Publishing
  defaultExportFormat              String   @default("epub")
  pageSize                         String   @default("6x9")
  includeTableOfContents           Boolean  @default(true)
  includeCopyrightPage             Boolean  @default(true)
  defaultCopyrightText             String?
  publisherName                    String?
  isbn                             String?
  authorBioForExport               String?
  frontMatterTemplate              String?
  backMatterTemplate               String?

  // Notifications
  writingReminderEnabled           Boolean  @default(true)
  writingReminderTime              String   @default("18:00")
  dailyGoalReminder                Boolean  @default(true)
  weeklyProgressEmail              Boolean  @default(false)
  exportCompletedNotification      Boolean  @default(true)
  aiTaskCompletedNotification      Boolean  @default(true)
  marketingReminder                Boolean  @default(false)

  // Privacy & Security
  manuscriptPrivacy                String   @default("private")
  allowAITrainingOnMyManuscript    Boolean  @default(false)
  dataExportRequested              Boolean  @default(false)

  // Appearance
  theme                            String   @default("dark")
  accentColor                      String   @default("gold")
  editorPaper                      String   @default("warm")
  editorFont                       String   @default("serif")
  reducedMotion                    Boolean  @default(false)
  compactSidebar                   Boolean  @default(false)

  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    @default("free")
  status               String    @default("free") // free | trialing | active | past_due | canceled | expired
  provider             String?   // midtrans | stripe | manual
  providerCustomerId   String?
  providerSubscriptionId String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
}

model UsageTracking {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart           DateTime @default(now())
  periodEnd             DateTime
  aiCreditsUsed         Int      @default(0)
  starterOutlinesUsed   Int      @default(0)
  revisionChecksUsed    Int      @default(0)
  fullRevisionChecksUsed Int     @default(0)
  translationWordsUsed  Int      @default(0)
  exportsUsed           Int      @default(0)
  marketingAssetsUsed   Int      @default(0)
  projectsCreated       Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([periodStart, periodEnd])
}

model UsageEvent {
  id            String   @id @default(cuid())
  userId        String
  projectId     String?
  type          String   // ai_credit | starter_outline | revision_check | full_revision_check | translation_word | export | marketing_asset | project_created
  amount        Int      @default(1)
  metadataJson  String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  genre          String?
  sourceLanguage String     @default("id")
  targetLanguage String     @default("en")
  status         String     @default("draft")
  plotOutline    String?
  styleGuide     String?
  coverImage     String?
  wordTarget     Int        @default(50000)
  chaptersTarget Int        @default(20)
  templateId     String?

  // Story Bible Overview fields
  premise        String?
  logline        String?
  theme          String?
  targetAudience String?
  pov            String?    // first_person | third_person_limited | third_person_omniscient | second_person
  tense          String?    // past | present | future
  tone           String?
  centralConflict String?
  stakes         String?
  endingIdea     String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  chapters       Chapter[]
  characters     Character[]
  exportJobs     ExportJob[]
  writingGoals   WritingGoal[]
  versions       ManuscriptVersion[]
  storyNotes     StoryNote[]
  locations      Location[]
  timelineEvents TimelineEvent[]
  comments       Comment[]
  plotBeats      PlotBeat[]
  relationships  Relationship[]
  researchItems      ResearchItem[]
  publishingMetadata  PublishingMetadata?
  frontMatter         FrontMatter?
  backMatter          BackMatter?
  publishingChecklist PublishingChecklist?

  @@index([userId])
}

model Chapter {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterNumber      Int
  title              String
  contentOriginal    String   @default("")
  contentTranslated  String?
  wordCount          Int      @default(0)
  status             String   @default("draft") // idea | drafting | revised | edited | locked
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  scenes             Scene[]
  versions           ManuscriptVersion[]
  storyNotes         StoryNote[]
  timelineEvents     TimelineEvent[]
  plotBeats          PlotBeat[]
  researchItems      ResearchItem[]

  @@index([projectId])
}

model Scene {
  id              String   @id @default(cuid())
  chapterId       String
  chapter         Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sceneNumber     Int
  title           String   @default("")
  content         String   @default("")
  summary         String   @default("")
  goal            String   @default("")
  conflict        String   @default("")
  outcome         String   @default("")
  emotionalShift  String   @default("")
  povCharacterId  String?
  povCharacter    Character? @relation("povCharacter", fields: [povCharacterId], references: [id], onDelete: SetNull)
  locationId      String?
  location        Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  wordCount       Int      @default(0)
  targetWordCount Int      @default(0)
  status          String   @default("idea") // idea | drafting | revised | edited | locked
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  storyNotes      StoryNote[]
  timelineEvents  TimelineEvent[]
  comments        Comment[]
  versions        ManuscriptVersion[]
  plotBeats       PlotBeat[]

  @@index([chapterId])
  @@index([locationId])
}

model WritingGoal {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         String   @default("daily") // daily | weekly | project
  targetWords  Int      @default(1000)
  currentWords Int      @default(0)
  startDate    DateTime @default(now())
  endDate      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
}

model ManuscriptVersion {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId  String?
  chapter    Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  sceneId    String?
  scene      Scene?    @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  content    String   @default("")
  wordCount  Int      @default(0)
  label      String   @default("")
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model StoryNote {
  id            String   @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  content       String   @default("")
  category      String   @default("general") // general | character | plot | worldbuilding | research | lore | rule | culture | magic | technology | politics | history | creature | object | timeline | relationship
  linkedCharacterId String?
  linkedLocationId String?
  linkedChapterId String?
  chapter       Chapter?  @relation(fields: [linkedChapterId], references: [id], onDelete: SetNull)
  linkedSceneId String?
  scene         Scene?    @relation(fields: [linkedSceneId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId])
}

model Location {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        String   @default("other") // city | village | kingdom | house | school | workplace | fantasy_realm | planet | other
  description String   @default("")
  mood        String?
  importance  String   @default("minor") // minor | major | critical
  rules       String?
  history     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scenes      Scene[]
  researchItems ResearchItem[]

  @@index([projectId])
}

model TimelineEvent {
  id              String   @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String   @default("")
  eventDateOrOrder Float?
  eventDateText   String?
  type            String   @default("main_plot") // backstory | main_plot | flashback | future | world_event
  linkedChapterId String?
  linkedSceneId   String?
  chapter         Chapter?  @relation(fields: [linkedChapterId], references: [id], onDelete: SetNull)
  scene           Scene?    @relation(fields: [linkedSceneId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId])
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId String?
  sceneId   String?
  scene     Scene?   @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  content   String   @default("")
  authorType String  @default("user") // user | ai | beta_reader
  status    String   @default("active") // active | resolved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Character {
  id                      String   @id @default(cuid())
  projectId               String
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                    String
  description             String   @default("")
  role                    String   @default("supporting") // protagonist | antagonist | love_interest | mentor | ally | rival | side_character | narrator | supporting
  age                     String?
  gender                  String?
  occupation              String?
  physicalDescription     String?
  personality             String?
  motivation              String?
  fear                    String?
  secret                  String?
  flaw                    String?
  strength                String?
  backstory               String?
  characterArc            String?
  relationshipToProtagonist String?
  firstAppearanceChapter   String?
  status                  String   @default("alive") // alive | dead | missing | unknown | not_applicable
  notes                   String?
  imageUrl                String?
  colorTag                String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  scenesAsPovCharacter Scene[]    @relation("povCharacter")
  researchItems        ResearchItem[]
  relationshipsAsA     Relationship[] @relation("characterA")
  relationshipsAsB     Relationship[] @relation("characterB")

  @@index([projectId])
}

model ExportJob {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  format      String   @default("epub") // epub | pdf | docx | markdown
  status      String   @default("pending") // pending | generating | completed | failed
  fileName    String?
  fileUrl     String?
  filePath    String?
  fileSize    Int      @default(0)
  errorMessage String?
  optionsJson String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
}

model PublishingMetadata {
  id              String   @id @default(cuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bookTitle       String?
  subtitle        String?
  seriesTitle     String?
  seriesNumber    Int?
  authorName      String?
  publisherName   String?
  language        String?
  genre           String?
  subgenre        String?
  keywordsJson    String?
  targetAudience  String?
  ageRange        String?
  isbn            String?
  copyrightYear   Int?
  copyrightHolder String?
  shortDescription String?
  longDescription String?
  logline         String?
  tagline         String?
  synopsis        String?
  blurb           String?
  amazonDescription String?
  goodreadsDescription String?
  authorBio       String?
  authorWebsite   String?
  authorSocialJson String?
  coverImageUrl   String?
  coverAssetId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
}

model FrontMatter {
  id                      String   @id @default(cuid())
  projectId               String   @unique
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  includeTitlePage        Boolean  @default(true)
  includeCopyrightPage    Boolean  @default(true)
  copyrightNotice         String?
  includeDedication       Boolean  @default(false)
  dedication              String?
  includeEpigraph         Boolean  @default(false)
  epigraph                String?
  includeForeword         Boolean  @default(false)
  foreword                String?
  includePreface          Boolean  @default(false)
  preface                 String?
  includeAcknowledgments  Boolean  @default(false)
  acknowledgments         String?
  includeTableOfContents  Boolean  @default(true)
  alsoByAuthor            String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([projectId])
}

model BackMatter {
  id                      String   @id @default(cuid())
  projectId               String   @unique
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  includeAboutAuthor      Boolean  @default(true)
  aboutAuthor             String?
  includeAuthorWebsite    Boolean  @default(false)
  authorWebsite           String?
  includeReviewRequest    Boolean  @default(false)
  reviewRequest           String?
  includeNewsletterSignup Boolean  @default(false)
  newsletterSignup        String?
  includeThankYou         Boolean  @default(false)
  thankYouNote            String?
  includeNextBookTeaser   Boolean  @default(false)
  nextBookTeaser          String?
  includeAlsoByAuthor     Boolean  @default(false)
  alsoByAuthor            String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([projectId])
}

model PublishingChecklist {
  id                String   @id @default(cuid())
  projectId         String   @unique
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metadataComplete  Boolean  @default(false)
  coverReady        Boolean  @default(false)
  synopsisReady     Boolean  @default(false)
  blurbReady        Boolean  @default(false)
  frontMatterReady  Boolean  @default(false)
  backMatterReady   Boolean  @default(false)
  manuscriptReady   Boolean  @default(false)
  revisionReady     Boolean  @default(false)
  exportReady       Boolean  @default(false)
  readinessScore    Int      @default(0)
  lastCheckedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId])
}

model PlotBeat {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template        String   @default("three-act") // three-act | heros-journey | save-the-cat | romance | mystery | webnovel | custom
  act             String   @default("act1") // act1 | act2 | act3 | section_name
  order           Float    @default(0)
  title           String
  description     String   @default("")
  status          String   @default("idea") // idea | planned | drafted | revised | locked
  linkedChapterId String?
  chapter         Chapter? @relation(fields: [linkedChapterId], references: [id], onDelete: SetNull)
  linkedSceneId   String?
  scene           Scene?   @relation(fields: [linkedSceneId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
}

model Relationship {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterAId    String
  characterA      Character @relation("characterA", fields: [characterAId], references: [id], onDelete: Cascade)
  characterBId    String
  characterB      Character @relation("characterB", fields: [characterBId], references: [id], onDelete: Cascade)
  type            String   @default("complicated") // family | romance | enemy | mentor | ally | rival | secret | complicated
  description     String   @default("")
  conflict        String?
  evolution       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
}

model ResearchItem {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  sourceUrl       String?
  summary         String   @default("")
  notes           String?
  relevance       String   @default("moderate") // low | moderate | high | critical
  linkedCharacterId String?
  linkedLocationId String?
  linkedChapterId String?
  chapter         Chapter?  @relation(fields: [linkedChapterId], references: [id], onDelete: SetNull)
  linkedSceneId   String?
  character       Character? @relation(fields: [linkedCharacterId], references: [id], onDelete: SetNull)
  location        Location?  @relation(fields: [linkedLocationId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
}
