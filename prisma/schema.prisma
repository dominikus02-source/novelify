// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  password        String?
  image           String?
  emailVerified   DateTime?
  plan            String    @default("free")
  wordCountUsed   Int       @default(0)
  dailyWordCount  Int       @default(0)
  dailyWordDate   String?   // YYYY-MM-DD, null = never used today
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  projects        Project[]
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  genre          String?
  sourceLanguage String     @default("id")
  targetLanguage String     @default("en")
  status         String     @default("draft")
  plotOutline    String?
  styleGuide     String?
  coverImage     String?
  wordTarget     Int        @default(50000)
  chaptersTarget Int        @default(20)
  templateId     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  chapters       Chapter[]
  characters     Character[]
  exports        Export[]
  writingGoals   WritingGoal[]
  versions       ManuscriptVersion[]
  storyNotes     StoryNote[]
  locations      Location[]
  timelineEvents TimelineEvent[]
  comments       Comment[]

  @@index([userId])
}

model Chapter {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterNumber      Int
  title              String
  contentOriginal    String   @default("")
  contentTranslated  String?
  wordCount          Int      @default(0)
  status             String   @default("draft") // idea | drafting | revised | edited | locked
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  scenes             Scene[]
  versions           ManuscriptVersion[]

  @@index([projectId])
}

model Scene {
  id              String   @id @default(cuid())
  chapterId       String
  chapter         Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sceneNumber     Int
  title           String   @default("")
  content         String   @default("")
  summary         String   @default("")
  goal            String   @default("")
  conflict        String   @default("")
  outcome         String   @default("")
  povCharacterId  String?
  wordCount       Int      @default(0)
  targetWordCount Int      @default(0)
  status          String   @default("idea") // idea | drafting | revised | edited | locked
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  storyNotes      StoryNote[]
  timelineEvents  TimelineEvent[]
  comments        Comment[]
  versions        ManuscriptVersion[]

  @@index([chapterId])
}

model WritingGoal {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         String   @default("daily") // daily | weekly | project
  targetWords  Int      @default(1000)
  currentWords Int      @default(0)
  startDate    DateTime @default(now())
  endDate      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
}

model ManuscriptVersion {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId  String?
  chapter    Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  sceneId    String?
  scene      Scene?    @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  content    String   @default("")
  wordCount  Int      @default(0)
  label      String   @default("")
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model StoryNote {
  id            String   @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  content       String   @default("")
  category      String   @default("general") // general | character | plot | worldbuilding | research
  linkedChapterId String?
  linkedSceneId String?
  scene         Scene?    @relation(fields: [linkedSceneId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId])
}

model Location {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  importance  String   @default("minor") // minor | major | critical
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model TimelineEvent {
  id              String   @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String   @default("")
  eventDateOrOrder Float?
  linkedSceneId   String?
  scene           Scene?    @relation(fields: [linkedSceneId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId])
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId String?
  sceneId   String?
  scene     Scene?   @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  content   String   @default("")
  authorType String  @default("user") // user | ai | beta_reader
  status    String   @default("active") // active | resolved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Character {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  role        String   @default("supporting") // protagonist | antagonist | supporting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model Export {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  format      String   @default("epub") // epub | pdf
  filePath    String?
  status      String   @default("pending") // pending | completed | failed
  createdAt   DateTime @default(now())

  @@index([projectId])
}
